{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gicio",
  "version": "0.1.0",
  "identifier": "dev.gicio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "gicio",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Marcin Sas-Szymański",
    "copyright": "Copyright 2026 Marcin Sas-Szymański",
    "shortDescription": "Review huge changes with AI assist",
    "windows": {
      "wix": {
        "language": {
          "en-US": {
            "localePath": "wix/en-US.wxl"
          }
        }
      }
    }
  }
}
